config {
  type: "view",
  schema: "analytics",
  name: "src_curated_customers_iceberg",
  description: "Source customers view from curated layer"
}

-- TEMPORAIRE ET PROPRE :
-- on évite de pointer vers une table inexistante `curated_dev.customer`
-- tant qu'on n'a pas validé son vrai nom en BigQuery.

SELECT
  1 AS customer_id,
  "dummy_customer" AS customer_name