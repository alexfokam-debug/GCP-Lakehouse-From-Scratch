config {
  type: "view",
  schema: "analytics",
  name: "stg_sales_transactions",
  description: "Staging view for sales transactions"
}

SELECT
  -- IMPORTANT :
  -- on aligne la clé de jointure avec le reste du modèle
  id AS order_id,

  amount AS transaction_amount,
  transaction_ts,
  load_ts,
  record_source
FROM ${ref("sales_transactions")}