config {
  type: "view",
  schema: "analytics",
  name: "int_orders_enriched",
  description: "Intermediate enriched orders model"
}

SELECT
  o.order_id,
  o.order_name,
  o.order_amount,
  o.order_date,
  o.order_ts,
  o.load_ts,
  o.record_source,

  s.transaction_amount,
  s.transaction_ts

FROM ${ref("stg_orders")} AS o
LEFT JOIN ${ref("stg_sales_transactions")} AS s
  ON o.order_id = s.order_id